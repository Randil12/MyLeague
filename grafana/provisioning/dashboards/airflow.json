{
  "uid": "myleague-airflow",
  "title": "Airflow · DAG tâches et scheduler",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "timezone": "browser",
  "time": {
    "from": "now-7d",
    "to": "now"
