  "panels": [
    {
      "id": 1,
      "title": "Dernier run de chaque DAG · y compris DAG en pause",
      "type": "table",
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "postgres",
        "uid": "airflow-monitoring"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT * FROM monitoring.dag_latest ORDER BY dag_id"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "Non renseigné"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "heartbeat_age_seconds"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 60
                    },
                    {
                      "color": "red",
                      "value": 180
                    }
                  ]
                }
              }
            ]
          }
        ]
      }
