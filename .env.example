# Copier vers .env et renseigner les valeurs. Ne JAMAIS commiter .env.
RIOT_API_KEY=RGAPI-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Leaguepedia (Bot Password : https://lol.fandom.com/wiki/Special:BotPasswords)
# Format username : "Utilisateur@NomDuBot"
LEAGUEPEDIA_USERNAME=Utilisateur@NomDuBot
LEAGUEPEDIA_PASSWORD=token-genere-par-botpasswords
# Réglages ingestion Leaguepedia (0 = année courante)
LEAGUEPEDIA_YEAR=0
LEAGUEPEDIA_LOOKBACK_DAYS=30
LEAGUEPEDIA_MAX_PAGES=20

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=myleague-data

# Warehouse Postgres (compte technique des pipelines)
GOLD_POSTGRES_USER=gold
GOLD_POSTGRES_PASSWORD=gold
GOLD_POSTGRES_DB=gold

# Rôles applicatifs Postgres (moindre privilège)
# data_engineer : accès complet aux schémas data
DATA_ENGINEER_USER=data_engineer
DATA_ENGINEER_PASSWORD=changez-moi-engineer
# data_analyst : lecture seule gold/reference/audit — utilisé par Grafana et Streamlit
DATA_ANALYST_USER=data_analyst
DATA_ANALYST_PASSWORD=changez-moi-analyst

# Airflow
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=admin

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Réglages ingestion Riot
RIOT_EUW_LOOKBACK_DAYS=7
RIOT_EUW_MAX_PLAYERS=25
RIOT_EUW_MATCHES_PER_PLAYER=10
RIOT_EUW_MAX_MATCHES_PER_RUN=250

# Timelines match-v5 (analyse par phase de jeu). Attention : double les appels API.
RIOT_EUW_INGEST_TIMELINES=true

# Méta par niveau de jeu : tiers supplémentaires à échantillonner.
# Format : TIER:DIVISION:PAGES, ex : DIAMOND:I:1,EMERALD:I:1 (vide = Master+ uniquement)
RIOT_EUW_EXTRA_TIERS=

# Pipeline quasi temps réel (spectator-v5) : joueurs interrogés par run.
RIOT_LIVE_MAX_PLAYERS=30

# Notification optionnelle des alertes de pipelines (Slack/Teams/webhook compatible JSON).
# Vide : alertes historisées uniquement dans audit.pipeline_alerts.
ALERT_WEBHOOK_URL=
